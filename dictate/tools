"""Measure the record button and pulse ring precisely from the screenshot."""
from PIL import Image

img = Image.open(r"C:\Users\Danculus\Desktop\dictate_preview.png").convert("RGB")
px = img.load()

crop = (110, 165, 280, 305)
xs_p, ys_p, xs_k, ys_k = [], [], [], []
for y in range(crop[1], crop[3]):
    for x in range(crop[0], crop[2]):
        r, g, b = px[x, y]
        if 110 < r < 175 and 70 < g < 120 and 200 < b < 255:
            xs_p.append(x); ys_p.append(y)
        elif r > 190 and 40 < g < 115 and 115 < b < 190:
            xs_k.append(x); ys_k.append(y)

if xs_p:
    print(f"button: x={min(xs_p)}..{max(xs_p)} y={min(ys_p)}..{max(ys_p)} center=({(min(xs_p)+max(xs_p))//2},{(min(ys_p)+max(ys_p))//2}) size={max(xs_p)-min(xs_p)}x{max(ys_p)-min(ys_p)}")
else:
    print("button: NOT FOUND")
if xs_k:
    print(f"ring:   x={min(xs_k)}..{max(xs_k)} y={min(ys_k)}..{max(ys_k)} center=({(min(xs_k)+max(xs_k))//2},{(min(ys_k)+max(ys_k))//2}) size={max(xs_k)-min(xs_k)}x{max(ys_k)-min(ys_k)}")
else:
    print("ring: NOT FOUND (between animation frames)")
