+    def cleanup(self, policy: str = "lru", max_items: Optional[int] = None, max_age: Optional[float] = None):
+        """Prune stale / low-value memories using the configured access_store.
+
+        Eviction is explicit and caller-triggered (never automatic). Requires `self.access_store` to be set.
+
+        Args:
+            policy: "lru" (oldest last_access), "lfu" (lowest hit_count), or "decay" (recency-weighted
+                frequency). See AccessStore.evict_candidates for exact semantics.
+            max_items: keep at most this many memories (evict the worst beyond it).
+            max_age: evict any memory whose last_access is older than this many seconds.
+
+        Returns:
+            dict: {"deleted": [memory_id, ...], "count": N}
+        """
+        if self.access_store is None:
+            raise ValueError("Memory.cleanup requires an access_store; set e.g. "
+                             "memory.access_store = SQLiteAccessStore(path) first.")
+        if max_items is None and max_age is None:
+            raise ValueError("cleanup needs at least one bound: max_items or max_age.")
+        candidates = self.access_store.evict_candidates(policy=policy, max_items=max_items, max_age=max_age)
+        deleted = []
+        for mid in candidates:
+            try:
+                self.delete(mid)
+                deleted.append(mid)
+            except ValueError:
+                pass  # already gone; still forget it from the sidecar below
+        if deleted:
+            self.access_store.forget(deleted)
+        return {"deleted": deleted, "count": len(deleted)}
+
