# Agora — Environment Variables
# Copy to .env and adjust

# Database (SQLite default, change to PostgreSQL for production)
AGORA_DATABASE_URL=sqlite+aiosqlite:///./agora.db
# AGORA_DATABASE_URL=postgresql+asyncpg://agora:agora@localhost:5432/agora

# Redis (optional, for distributed stigmergy)
AGORA_REDIS_URL=redis://localhost:6379/0
AGORA_USE_REDIS=false

# LLM API (optional — simulated thoughts used when disabled)
AGORA_API_KEY=
AGORA_API_BASE_URL=https://api.deepseek.com/v1
AGORA_LLM_MODEL_CHEAP=deepseek-v4-flash
AGORA_LLM_MODEL_MEDIUM=deepseek-v4-flash
AGORA_LLM_MODEL_EXPERT=deepseek-v4-flash
AGORA_LLM_ENABLED=false

# Engine
AGORA_TICK_INTERVAL=5
AGORA_MAX_AGENTS=30
AGORA_DEBUG=true
